@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap");

:root {
  font-family: "DM Sans", sans-serif;
  color: #182033;
  background: #f5f7fb;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
}

button,
input,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

button:focus-visible,
input:focus-visible,
select:focus-visible {
  outline: 2px solid #5967e8;
  outline-offset: 2px;
}

/* =========================================
   APP SHELL
========================================= */

.app-shell {
  min-height: 100vh;
  display: flex;
  background: #f5f7fb;
}

/* =========================================
   SIDEBAR
========================================= */

.sidebar {
  width: 252px;
  min-height: 100vh;
  background: #ffffff;
  border-right: 1px solid #e8ebf1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 25px 15px 18px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 10px;
  margin-bottom: 43px;
}

.brand-mark {
  width: 37px;
  height: 37px;
  border-radius: 11px;
  background: #182033;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 17px;
  font-weight: 700;
  box-shadow: 0 5px 14px rgba(24, 32, 51, 0.15);
}

.brand-name {
  font-size: 15px;
  font-weight: 700;
  color: #182033;
}

.brand-subtitle {
  margin-top: 2px;
  font-size: 10px;
  color: #98a0af;
  font-weight: 500;
}

.navigation {
  display: flex;
  flex-direction: column;
}

.nav-label {
  padding: 0 12px;
  margin: 0 0 9px;
  font-size: 9px;
  font-weight: 700;
  color: #a0a7b4;
  letter-spacing: 1.3px;
}

.second-label {
  margin-top: 31px;
}

.nav-item {
  width: 100%;
  height: 43px;
  border: none;
  background: transparent;
  color: #737c8d;
  border-radius: 9px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 12px;
  margin-bottom: 4px;
  text-align: left;
  font-size: 13px;
  font-weight: 500;
  transition: 0.18s ease;
}

.nav-item:hover {
  color: #182033;
  background: #f5f6fa;
}

.nav-item.active {
  background: #eef0ff;
  color: #4f5dd8;
  font-weight: 600;
}

.nav-item svg {
  flex-shrink: 0;
}

.nav-count {
  margin-left: auto;
  min-width: 22px;
  height: 21px;
  border-radius: 6px;
  background: #f0f2f6;
  color: #777f8e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  font-weight: 600;
}

.nav-item.active .nav-count {
  background: #ffffff;
  color: #5967df;
}

.profile-card {
  border: 1px solid #e9ebf0;
  border-radius: 11px;
  padding: 11px;
  display: flex;
  align-items: center;
  gap: 9px;
}

.avatar {
  width: 34px;
  height: 34px;
  border-radius: 9px;
  background: #e9ecff;
  color: #4e5bcf;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  font-weight: 700;
}

.profile-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.profile-info strong {
  font-size: 11px;
  color: #303848;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.profile-info span {
  font-size: 10px;
  color: #99a0ad;
}

.profile-dot {
  width: 7px;
  height: 7px;
  background: #42b883;
  border-radius: 50%;
  margin-left: auto;
}

/* =========================================
   MAIN AREA
========================================= */

.main-area {
  flex: 1;
  min-width: 0;
}

/* =========================================
   TOPBAR
========================================= */

.topbar {
  height: 72px;
  padding: 0 38px;
  border-bottom: 1px solid #e8ebf1;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  position: sticky;
  top: 0;
  z-index: 10;
  backdrop-filter: blur(12px);
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 10px;
}

.icon-button {
  width: 38px;
  height: 38px;
  border: 1px solid #e4e7ed;
  border-radius: 9px;
  background: #ffffff;
  color: #7a8291;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-button:hover {
  background: #f7f8fb;
  color: #4e596b;
}

.add-button {
  height: 38px;
  padding: 0 15px;
  border: none;
  border-radius: 9px;
  background: #5362dc;
  color: #ffffff;
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 12px;
  font-weight: 600;
  box-shadow: 0 5px 13px rgba(83, 98, 220, 0.2);
  transition: 0.18s ease;
}

.add-button:hover {
  background: #4655ce;
  transform: translateY(-1px);
}

.mobile-brand {
  display: none;
}

/* =========================================
   CONTENT
========================================= */

.content {
  width: min(1260px, calc(100% - 76px));
  margin: 0 auto;
  padding: 42px 0 60px;
}

/* =========================================
   WELCOME
========================================= */

.welcome-section {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 30px;
  margin-bottom: 30px;
}

.page-kicker {
  margin: 0 0 9px;
  color: #8a93a3;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.4px;
}

.welcome-section h1 {
  margin: 0;
  color: #182033;
  font-size: clamp(32px, 3.4vw, 45px);
  line-height: 1.08;
  letter-spacing: -1.6px;
  font-weight: 700;
}

.welcome-section h1 span {
  color: #5967df;
}

.welcome-text {
  max-width: 600px;
  margin: 13px 0 0;
  color: #788193;
  font-size: 13px;
  line-height: 1.65;
}

.date-card {
  min-width: 152px;
  padding: 14px 16px;
  border: 1px solid #e6e9ef;
  border-radius: 11px;
  background: #ffffff;
}

.date-card span {
  display: block;
  color: #9aa2b0;
  font-size: 10px;
  margin-bottom: 4px;
}

.date-card strong {
  color: #343c4d;
  font-size: 12px;
}

/* =========================================
   STATS
========================================= */

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 13px;
  margin-bottom: 30px;
}

.stat-card {
  min-height: 135px;
  padding: 18px;
  border: 1px solid #e5e8ee;
  border-radius: 13px;
  background: #ffffff;
  box-shadow: 0 3px 12px rgba(29, 39, 61, 0.025);
}

.stat-card.primary {
  border-color: #e0e3ff;
  background: #fafaff;
}

.stat-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stat-card-top > span {
  color: #818999;
  font-size: 10px;
  font-weight: 600;
}

.stat-icon {
  width: 29px;
  height: 29px;
  border-radius: 8px;
  background: #5967df;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-icon.light {
  background: #f2f3f7;
  color: #687285;
}

.stat-card > strong {
  display: block;
  margin-top: 12px;
  color: #1a2234;
  font-size: 29px;
  line-height: 1;
}

.stat-footer {
  margin-top: 12px;
  display: flex;
  align-items: center;
  gap: 5px;
  color: #9aa1ae;
  font-size: 9px;
}

.stat-footer.positive {
  color: #3b9b6d;
}

.stat-footer.warning {
  color: #a37a2e;
}

/* =========================================
   DASHBOARD GRID
========================================= */

.dashboard-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.7fr) minmax(280px, 0.9fr);
  gap: 17px;
}

.panel {
  border: 1px solid #e5e8ee;
  border-radius: 14px;
  background: #ffffff;
  box-shadow: 0 3px 14px rgba(29, 39, 61, 0.025);
}

.opportunities-panel {
  min-width: 0;
}

.panel-header {
  padding: 20px 21px 17px;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 15px;
}

.panel-kicker {
  margin: 0 0 5px;
  color: #9aa1af;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1.2px;
}

.panel-header h2 {
  margin: 0;
  color: #252d3e;
  font-size: 16px;
  font-weight: 700;
}

.view-button {
  border: none;
  background: transparent;
  color: #5967d7;
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 3px 0;
  font-size: 10px;
  font-weight: 600;
}

.view-button:hover {
  color: #404fc8;
}

.more-button {
  border: none;
  background: transparent;
  color: #8f97a5;
  letter-spacing: 2px;
  padding: 0;
}

/* =========================================
   FILTERS
========================================= */

.filters {
  padding: 0 21px 14px;
  display: flex;
  gap: 9px;
}

.search-field {
  height: 38px;
  flex: 1;
  min-width: 0;
  border: 1px solid #e5e8ee;
  border-radius: 8px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 11px;
  color: #969eab;
  background: #fafbfc;
}

.search-field input {
  width: 100%;
  border: none;
  outline: none;
  background: transparent;
  color: #303849;
  font-size: 11px;
}

.search-field input::placeholder {
  color: #a2a9b4;
}

.filters select {
  width: 125px;
  border: 1px solid #e5e8ee;
  border-radius: 8px;
  padding: 0 10px;
  background: #fafbfc;
  color: #5f6878;
  font-size: 10px;
  outline: none;
}

/* =========================================
   OPPORTUNITY LIST
========================================= */

.opportunity-list {
  border-top: 1px solid #eef0f3;
}

.opportunity-row {
  min-height: 96px;
  padding: 17px 21px;
  display: flex;
  align-items: center;
  gap: 13px;
  border-bottom: 1px solid #eef0f3;
  transition: 0.18s ease;
}

.opportunity-row:last-child {
  border-bottom: none;
}

.opportunity-row:hover {
  background: #fafbff;
}

.opportunity-logo {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  border-radius: 10px;
  background: #f0f2ff;
  color: #5362d9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 700;
}

.opportunity-details {
  flex: 1;
  min-width: 0;
}

.opportunity-title-row {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.opportunity-title-row h3 {
  margin: 0;
  color: #2b3343;
  font-size: 12px;
  font-weight: 700;
}

.opportunity-details > p {
  margin: 3px 0 7px;
  color: #8a92a0;
  font-size: 10px;
}

.opportunity-meta {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #9aa1ad;
  font-size: 9px;
}

.meta-separator {
  color: #c7cbd2;
}

.status {
  padding: 3px 7px;
  border-radius: 20px;
  font-size: 8px;
  font-weight: 600;
}

.status.saved {
  background: #fff4dc;
  color: #9a7428;
}

.status.interested {
  background: #e8f7ef;
  color: #37855c;
}

.status.applied {
  background: #e9edff;
  color: #5364c9;
}

.row-arrow {
  width: 30px;
  height: 30px;
  flex-shrink: 0;
  border: 1px solid #e9ebf0;
  border-radius: 8px;
  background: #ffffff;
  color: #9199a6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.row-arrow:hover {
  color: #5362d9;
  border-color: #dce0f7;
  background: #f8f9ff;
}

/* =========================================
   PIPELINE
========================================= */

.pipeline-panel {
  min-width: 0;
}

.pipeline {
  padding: 4px 21px 8px;
}

.pipeline-item {
  margin-bottom: 18px;
}

.pipeline-item:last-child {
  margin-bottom: 8px;
}

.pipeline-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 7px;
  color: #4d5667;
  font-size: 10px;
}

.pipeline-label strong {
  color: #2d3545;
  font-size: 10px;
}

.pipeline-name {
  display: flex;
  align-items: center;
  gap: 7px;
}

.pipeline-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
}

.saved-dot {
  background: #d8aa43;
}

.interested-dot {
  background: #53ae79;
}

.applied-dot {
  background: #6677dc;
}

.interview-dot {
  background: #a68ce2;
}

.selected-dot {
  background: #38a28b;
}

.progress-track {
  height: 5px;
  border-radius: 10px;
  background: #f0f1f4;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
}

.saved-fill {
  background: #d8aa43;
}

.interested-fill {
  background: #53ae79;
}

.applied-fill {
  background: #6677dc;
}

.interview-fill {
  background: #a68ce2;
}

.selected-fill {
  background: #38a28b;
}

.pipeline-tip {
  margin: 13px 17px 17px;
  padding: 13px;
  border-radius: 10px;
  background: #f7f8ff;
  display: flex;
  gap: 9px;
}

.tip-icon {
  width: 28px;
  height: 28px;
  flex-shrink: 0;
  border-radius: 8px;
  background: #e9ecff;
  color: #5967d9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pipeline-tip strong {
  color: #41495a;
  display: block;
  font-size: 10px;
}

.pipeline-tip p {
  margin: 4px 0 0;
  color: #8b93a1;
  font-size: 9px;
  line-height: 1.45;
}

/* =========================================
   EMPTY
========================================= */

.empty-state {
  text-align: center;
  padding: 45px 20px;
}

.empty-state h3 {
  margin: 0;
  color: #343c4d;
  font-size: 13px;
}

.empty-state p {
  margin: 6px 0 0;
  color: #9aa1ad;
  font-size: 10px;
}

/* =========================================
   RESPONSIVE
========================================= */

@media (max-width: 1100px) {
  .sidebar {
    width: 220px;
  }

  .content {
    width: min(100% - 46px, 1100px);
  }

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .dashboard-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 760px) {
  .sidebar {
    display: none;
  }

  .topbar {
    height: 64px;
    padding: 0 18px;
    justify-content: space-between;
  }

  .mobile-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #182033;
    font-size: 13px;
  }

  .mobile-brand .brand-mark {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    font-size: 14px;
  }

  .content {
    width: calc(100% - 30px);
    padding: 28px 0 45px;
  }

  .welcome-section {
    align-items: flex-start;
    flex-direction: column;
  }

  .date-card {
    width: 100%;
  }

  .stats-grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 520px) {
  .topbar .icon-button {
    display: none;
  }

  .add-button {
    padding: 0 12px;
  }

  .add-button span {
    display: none;
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }

  .welcome-section h1 {
    font-size: 34px;
  }

  .filters {
    flex-direction: column;
  }

  .filters select {
    width: 100%;
    height: 38px;
  }

  .opportunity-row {
    align-items: flex-start;
  }

  .row-arrow {
    display: none;
  }

  .opportunity-title-row {
    align-items: flex-start;
    flex-direction: column;
    gap: 5px;
  }
}